  "default_settings": {
    "quote_match_threshold": 98.0,
    "allow_alterations": true,
    "max_ellipses": 3,
    "require_pinpoint_verification": true,
    "flag_nested_quotes": true,
    "flag_block_quotes": false,
    "minimum_quote_length": 10
  },
  "validation_rules": {
    "citation_format": {
      "require_volume": true,
      "require_reporter": true,
      "require_page": true,
      "allow_short_citations": true,
      "allow_id_citations": true
    },
    "quote_validation": {
      "exact_match_threshold": 98.0,
      "high_match_threshold": 90.0,
      "medium_match_threshold": 80.0,
      "min_acceptable_threshold": 80.0,
      "flag_alterations": true,
      "flag_ellipses": true
    },
    "parallel_citations": {
      "auto_suggest": true,
      "require_for_state_courts": true,
      "require_for_federal_courts": false
    }
  },
