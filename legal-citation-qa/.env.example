# Legal Citation QA System - Environment Variables
# Copy this file to .env and fill in your credentials

# ============================================================================
# CourtListener API
# ============================================================================
# Get your token at: https://www.courtlistener.com/api/rest-info/
COURTLISTENER_TOKEN=your_courtlistener_api_token_here

# ============================================================================
# Box Integration
# ============================================================================
# Box Developer Console: https://app.box.com/developers/console
BOX_CLIENT_ID=your_box_client_id_here
BOX_CLIENT_SECRET=your_box_client_secret_here
BOX_ACCESS_TOKEN=your_box_access_token_here

# Box Webhook Signing Key (found in Box Developer Console -> Webhooks)
BOX_WEBHOOK_SIGNING_KEY=your_webhook_signing_key_here

# Box Folder IDs
BOX_DRAFTS_FOLDER_ID=123456789
BOX_QA_FOLDER_ID=987654321

# ============================================================================
# Git Audit Trail
# ============================================================================
# Local path to git repository for audit trail
GIT_AUDIT_PATH=/data/audit

# Optional: Remote git repository URL for backup
# GIT_REMOTE_URL=git@github.com:your-org/citation-qa-audit.git

# Git credentials (if using HTTPS)
# GIT_USERNAME=
# GIT_PASSWORD=

# ============================================================================
# Storage & Output
# ============================================================================
OUTPUT_DIR=/data/reports
TEMP_DIR=/tmp/citation-qa

# ============================================================================
# Webhook Server
# ============================================================================
HOST=0.0.0.0
PORT=8000

# Verify webhook signatures (true/false)
VERIFY_WEBHOOKS=true

# ============================================================================
# Application Settings
# ============================================================================
# Environment: development, staging, production
ENVIRONMENT=production

# Debug mode (true/false)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# Processing Settings
# ============================================================================
# Quote matching thresholds (0-100)
EXACT_THRESHOLD=98.0
HIGH_THRESHOLD=90.0
MEDIUM_THRESHOLD=80.0

# Maximum concurrent jobs
MAX_CONCURRENT_JOBS=5

# Job timeout (seconds)
JOB_TIMEOUT=600

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_PARALLEL_CITATION_CHECKING=true
ENABLE_QUOTE_MATCHING=true
ENABLE_BOX_INTEGRATION=true
ENABLE_GIT_AUDIT=true
ENABLE_REPORT_SIGNING=true

# ============================================================================
# Optional: Notifications
# ============================================================================
# Email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# NOTIFICATION_EMAIL=qa-alerts@example.com

# Slack notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# Development/Testing
# ============================================================================
# Use mock services for testing (true/false)
USE_MOCK_SERVICES=false
